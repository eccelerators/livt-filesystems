namespace Livt.FileSystems.Tests

using Livt.IO

/**
 * Sparse in-memory disk with FAT32 geometry and an intentionally fragmented file.
 */
component Fat32DiskModel : IReadOnlyBlockDevice
{
	// Fixture selection, fault injection and externally visible media state.
	public layout: byte
	public fault: byte
	public attached: bool
	public reads: int
	public rejectByte: bool
	public latency: int

	// Retained block request and simulated completion delay.
	address: uint
	readState: BlockReadState
	delay: int

	/**
	 * Restores an idle disk; callers first finish/cancel their previous operation.
	 */
	public fn Reset(layout: byte, fault: byte)
	{
		this.layout = layout
		this.fault = fault
		attached = true
		reads = 0
		rejectByte = false
		latency = 2
		readState = BlockReadState.Idle
	}

	/**
	 * Returns the fixture attachment state.
	 */
	override fn IsReady() bool
	{
		return attached
	}

	/**
	 * Returns the fixed logical capacity without allocating a whole disk.
	 */
	override fn GetBlockCount() uint
	{
		return 100000
	}

	/**
	 * Returns the supported 512-byte sector size.
	 */
	override fn GetBlockSize() int
	{
		return 512
	}

	/**
	 * Accepts one in-range LBA while attached and idle; completion is deferred.
	 */
	override fn TryReadBlock(lba: uint) bool
	{
		if (!attached || readState != BlockReadState.Idle || lba >= 100000) {
			return false
		}

		address = lba
		delay = latency
		reads++
		readState = BlockReadState.Active
		return true
	}

	/**
	 * Advances the simulated delay and exposes retained completion or failure.
	 */
	override fn GetReadState() BlockReadState
	{
		if (readState == BlockReadState.Active) {
			if (!attached) {
				readState = BlockReadState.Failed
			} elif (delay == 0) {
				readState = BlockReadState.Complete
			} else {
				delay--
			}
		}

		return readState
	}

	/**
	 * Reads a byte only from successful retained completion; false yields zero.
	 */
	override fn TryReadByte(index: int, value: out byte) bool
	{
		value = 0

		if (!attached || rejectByte || readState != BlockReadState.Complete || index < 0 || index >= 512) {
			return false
		}

		value = DiskByte(address, index)
		return true
	}

	/**
	 * Changes an active read to a retained failure; false preserves other states.
	 */
	override fn CancelRead() bool
	{
		if (readState != BlockReadState.Active) {
			return false
		}

		readState = BlockReadState.Failed
		return true
	}

	/**
	 * Releases terminal completion, returning the fixture to idle.
	 */
	override fn ReleaseRead() bool
	{
		if (readState == BlockReadState.Active || readState == BlockReadState.Idle) {
			return false
		}

		readState = BlockReadState.Idle
		return true
	}

	/**
	 * Returns fixture bytes; faults affect geometry, chain, CRC or directory bounds.
	 */
	fn DiskByte(lba: uint, index: int) byte
	{
		var start: uint = 2048

		if (layout == 0) {
			start = 0
		}

		if (lba == start) {
			if (fault == 1 && index == 13) {
				return 3
			}

			if (fault == 2 && index == 39) {
				return 255
			}

			return BOOT[index]
		}

		if (lba == 0) {
			if (layout == 2) {
				return PROTECTIVE[index]
			}

			return MBR[index]
		}

		if (layout == 2 && lba == 1) {
			if (fault == 3 && index == 56) {
				return 42
			}

			return GPT[index]
		}

		if (layout == 2 && lba >= 2 && lba < 34) {
			if (fault == 4 && lba == 33 && index == 511) {
				return 1
			}

			if (lba == 2 && index < 128) {
				return ENTRY[index]
			}

			return 0
		}

		if (lba == start + 32) {
			var cluster = index / 4
			var link: uint = 0

			if (cluster == 0) {
				link = 0x0FFFFFF8
			}

			if (cluster == 1 || cluster == 2 || cluster == 4) {
				link = 0x0FFFFFFF
			}

			if (cluster == 3) {
				link = 7
			}

			if (cluster == 7) {
				link = 4
			}

			if (fault == 5 && cluster == 3) {
				link = 0x0FFFFFFF
			}

			if (fault == 6 && cluster == 7) {
				link = 3
			}

			if (fault == 7 && cluster == 7) {
				link = 90000
			}

			if (fault == 8 && cluster == 2) {
				link = 2
			}

			return ((link >> ((index % 4) * 8)) & 255) as byte
		}

		if (lba == start + 1056) {
			if (fault == 8) {
				return 0xE5
			}

			if (fault == 9 && index == 92) {
				return 255
			}

			if (fault == 9 && index == 93) {
				return 255
			}

			if (fault == 9 && index == 94) {
				return 255
			}

			if (fault == 9 && index == 95) {
				return 255
			}

			return ROOT[index]
		}

		if (lba == start + 1057) {
			return (index & 255) as byte
		}

		if (lba == start + 1061) {
			return ((index + 17) & 255) as byte
		}

		if (lba == start + 1058) {
			return ((index + 33) & 255) as byte
		}

		return 0
	}

